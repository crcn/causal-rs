{
  "name": "causal-inspector",
  "version": "0.2.1",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/causal-inspector.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && cp src/CausalInspector.css dist/ && npm run build:css",
    "build:css": "postcss src/styles.css -o dist/causal-inspector.css",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "graphql-ws": "^6.0.0",
    "immer": "^10.0.0",
    "lucide-react": "^0.575.0"
  },
  "peerDependencies": {
    "@dagrejs/dagre": "^1.0.0",
    "@xyflow/react": "^12.0.0",
    "flexlayout-react": ">=0.7.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@xyflow/react": {
      "optional": true
    },
    "@dagrejs/dagre": {
      "optional": true
    },
    "flexlayout-react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@dagrejs/dagre": "^2.0.4",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.3",
    "@xyflow/react": "^12.10.1",
    "flexlayout-react": "^0.8.19",
    "postcss": "^8.5.15",
    "postcss-cli": "^11.0.1",
    "postcss-prefix-selector": "^2.1.1",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.0.0"
  }
}
